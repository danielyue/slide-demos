<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:type="ContentApp">
  <Id>157ce4b8-984b-4227-9259-e47e662996de</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Daniel Yue</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Slide Demos (viewer)"/>
  <Description DefaultValue="Shows a live web page on a slide; each slide stores its own address."/>
  <IconUrl DefaultValue="https://danielyue.github.io/slide-demos/addin/icon-32.png"/>
  <HighResolutionIconUrl DefaultValue="https://danielyue.github.io/slide-demos/addin/icon-64.png"/>
  <SupportUrl DefaultValue="https://danielyue.github.io/slide-demos/"/>
  <AppDomains>
    <AppDomain>https://danielyue.github.io</AppDomain>
    <AppDomain>https://mdr.dny</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Presentation"/>
  </Hosts>
  <DefaultSettings>
    <SourceLocation DefaultValue="https://danielyue.github.io/slide-demos/viewer/"/>
    <RequestedWidth>960</RequestedWidth>
    <RequestedHeight>540</RequestedHeight>
  </DefaultSettings>
  <Permissions>ReadDocument</Permissions>
  <AllowSnapshot>true</AllowSnapshot>
</OfficeApp>
